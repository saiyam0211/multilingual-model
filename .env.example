# Copy to .env and fill in. .env is gitignored.

# Hugging Face
HF_TOKEN=hf_xxx

# Weights & Biases (optional but recommended)
WANDB_API_KEY=

# Target model serving — DEV target (free HF inference, no GPU required)
# Llama-3.1-8B-Instruct is gated on free serverless. Use Qwen for dev,
# swap in Llama-3.1-8B for final eval via dedicated Endpoint or vLLM Space.
TARGET_PROVIDER=hf-inference
TARGET_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Final-eval target (uncomment when you spin up dedicated endpoint / vLLM Space)
# TARGET_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# TARGET_BASE_URL=https://your-username-target.hf.space/v1

# Local dev: skip GPU loads (Llama-Guard mocked with keyword heuristic)
MOCK_GPU=1

# Reward composer weights (override here without code change)
W_HARM=1.0
W_NON_REFUSAL=0.4
W_NOVELTY=0.3
GIBBERISH_PPL_THRESHOLD=200.0
LANG_ID_THRESHOLD=0.7
